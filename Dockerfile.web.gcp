# idswyft frontend for GCP Cloud Run (same-origin: nginx proxies /api → idswyft API)
FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install --legacy-peer-deps
ARG VITE_EDITION=community
COPY frontend/ .
# Force same-origin API (relative /api via nginx proxy) — drop any cloud override
RUN rm -f .env.production
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.gcp.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
